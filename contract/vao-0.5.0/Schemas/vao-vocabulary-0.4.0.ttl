<https://w3id.org/modavis/vao/0.4.0/vocabulary> a owl:Ontology ;
  dcterms:title "Virtual Acoustic Object (VAO) 0.4.0 vocabulary"@en ;
  dcterms:description "Core RDF terms used by the semantic projection of VAO 0.4.0 manifests."@en ;
  dcterms:creator <https://orcid.org/0000-0002-7904-3892> ;
  dcterms:modified "2026-08-27"^^xsd:date ;
  dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
  owl:versionIRI <https://w3id.org/modavis/vao/0.4.0/vocabulary> ;
  owl:versionInfo "0.4.0" .

<https://orcid.org/0000-0002-7904-3892> a prov:Person ; rdfs:label "Dominik Ukolov" .

vao:VirtualAcousticObject a owl:Class ; rdfs:label "Virtual Acoustic Object"@en ;
  rdfs:comment "An immutable semantic release describing an acoustic object and its exact digital realizations."@en .
