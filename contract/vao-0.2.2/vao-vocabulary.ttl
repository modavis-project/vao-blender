<https://w3id.org/modavis/vao/ontology> a owl:Ontology ;
  dcterms:title "VAO container extension vocabulary"@en ;
  dcterms:description "Terms for evidence, acoustic scenes, spatial media, runtime rendering, and analytical records needed by VAO 0.2 and not yet released by the MODAVIS Ontology Network."@en ;
  dcterms:creator <https://orcid.org/0000-0002-7904-3892> ;
  owl:versionInfo "0.2.2" ;
  owl:imports <https://w3id.org/modavis/ontology/audio> .

